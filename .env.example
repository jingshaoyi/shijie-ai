# ============================================
# 识界AI 环境变量配置示例
# 复制此文件为 .env 并修改配置
# ============================================

# --------------------------------------------
# 应用基础配置
# --------------------------------------------
APP_NAME=识界AI
DEBUG=false
HOST=0.0.0.0
PORT=9090

# 安全密钥（重要！生产环境必须修改）
# 可以使用: openssl rand -hex 32 生成
SECRET_KEY=your-super-secret-key-change-this-in-production

# --------------------------------------------
# 数据库配置
# --------------------------------------------
# SQLite（开发环境默认）
DATABASE_URL=sqlite:///data/shijie_ai.db

# PostgreSQL（生产环境推荐）
# DATABASE_URL=postgresql://user:password@localhost:5432/shijie_ai

# MySQL
# DATABASE_URL=mysql+pymysql://user:password@localhost:5432/shijie_ai

# --------------------------------------------
# AI模型API密钥（至少配置一个）
# --------------------------------------------
# 阿里云DashScope（通义千问）- 推荐
DASHSCOPE_API_KEY=your-dashscope-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key

# --------------------------------------------
# 微信小程序配置
# --------------------------------------------
WECHAT_APPID=your-wechat-miniprogram-appid
WECHAT_SECRET=your-wechat-miniprogram-secret

# --------------------------------------------
# 文件上传配置
# --------------------------------------------
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE=5242880
ALLOWED_IMAGE_TYPES=["image/jpeg", "image/png", "image/gif", "image/webp"]

# --------------------------------------------
# CORS配置（开发环境）
# --------------------------------------------
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# --------------------------------------------
# 日志配置
# --------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --------------------------------------------
# 提示词模板配置
# --------------------------------------------
# 提示词缓存有效期（小时）
PROMPT_CACHE_TTL=24

# 自动更新提示词（通过定时任务）
AUTO_UPDATE_PROMPTS=true
